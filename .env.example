# ============================================================
# IEEE Zerone — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control!

# ─── Firebase Client (Public — for Firestore real-time reads) ───
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Firebase Admin SDK (Server-side only — no NEXT_PUBLIC) ─────
# Paste the ENTIRE contents of your serviceAccountKey.json as a single-line JSON string
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"..."}

# ─── JWT Session Security ────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-long-random-secret-here-minimum-32-characters

# ─── Admin Access ───────────────────────────────────────────────
ADMIN_PASSWORD=your-secure-admin-password
